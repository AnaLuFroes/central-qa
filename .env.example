# Copie para .env e preencha com a config do app web do Firebase (Console > Configurações do projeto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Chave usada (junto com o uid) para cifrar o estado persistido do Redux no navegador.
VITE_PERSIST_SECRET=troque-esta-chave
